# ─── Astralium Digitale Store — environment ────────────────────────────────
# Copy to .env.local (or set in Vercel → Project → Settings → Environment
# Variables). Everything below is OPTIONAL for browsing the store; payments,
# admin and email only activate when their keys are present. The app never
# invents a payment: without keys, checkout returns PAYMENTS_NOT_CONFIGURED.

# Public site URL (canonical, sitemap, Stripe return URLs)
# Where: your domain / Vercel deployment URL
NEXT_PUBLIC_SITE_URL=https://astralium-store-v1.vercel.app

# ─── Stripe (cards, Apple Pay, Google Pay, Link, iDEAL, SEPA…) ────────────
# Where: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Where: Stripe Dashboard → Developers → Webhooks → your endpoint signing secret
STRIPE_WEBHOOK_SECRET=

# ─── PayPal (balance, Pay Later, cards) ────────────────────────────────────
# Where: https://developer.paypal.com/dashboard/applications
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# PAYPAL_ENV=live (default) or sandbox
PAYPAL_ENV=live
# Where: PayPal developer dashboard → Webhooks → Webhook ID
PAYPAL_WEBHOOK_ID=

# ─── Email (order receipts, download links, abandoned cart, newsletter) ────
# Where: https://resend.com/api-keys
RESEND_API_KEY=
# Sender identity, e.g. "Astralium <orders@yourdomain.com>"
EMAIL_FROM=Astralium Digitale Store <orders@example.com>

# ─── Admin (/[locale]/control-astralium) ───────────────────────────────────
# Choose a long random password yourself. If unset, admin login is disabled
# and the login page explains that it must be set.
ADMIN_PASSWORD=

# ─── Download link signing ─────────────────────────────────────────────────
# Any long random string (>= 32 chars). Used to HMAC-sign download tokens.
DOWNLOAD_SIGNING_SECRET=

# ─── Database (Phase 1 — orders, flags, file bindings, grants) ─────────────
# Optional: without it the store runs on the file catalog and admin file
# bindings persist to a local .data/ file instead. Set it to make feature
# flags, orders and product-file bindings durable.
# Where: your Postgres host — e.g. Neon (neon.tech → connection string),
# Supabase (Project → Settings → Database), Railway, or self-hosted.
DATABASE_URL=

# ─── Product file storage (Phase 1 — S3 / S3-compatible, private bucket) ───
# All four core keys are required together; the bucket must be PRIVATE
# (files are only ever served through short-lived presigned URLs).
# Where: AWS S3 console (bucket + IAM access key), Cloudflare R2 dashboard
# (R2 → Manage API tokens), Wasabi, or MinIO for local development.
S3_BUCKET=
# Where: the bucket's region (AWS console header / R2: use "auto").
S3_REGION=
# Where: the same console's access-key / API-token page.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Custom endpoint for S3-compatible providers; leave empty for AWS S3.
# Where: R2 → bucket details (https://<account>.r2.cloudflarestorage.com),
# MinIO (http://localhost:9000), Wasabi region endpoint.
S3_ENDPOINT=
# "1" for path-style addressing (required by MinIO, optional for R2);
# leave empty for AWS / virtual-host style.
S3_FORCE_PATH_STYLE=

# ─── AI support assistant (optional) ───────────────────────────────────────
# Where: https://platform.openai.com/api-keys — without it, the assistant
# answers from the local catalog/policy data only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

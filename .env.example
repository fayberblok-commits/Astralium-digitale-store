# ─── Astralium Digitale Store — environment ────────────────────────────────
# Copy to .env.local (or set in Vercel → Project → Settings → Environment
# Variables). Everything below is OPTIONAL for browsing the store; payments,
# admin and email only activate when their keys are present. The app never
# invents a payment: without keys, checkout returns PAYMENTS_NOT_CONFIGURED.

# Public site URL (canonical, sitemap, Stripe return URLs)
# Where: your domain / Vercel deployment URL
NEXT_PUBLIC_SITE_URL=https://astralium-store-v1.vercel.app

# ─── Stripe (cards, Apple Pay, Google Pay, Link, iDEAL, SEPA…) ────────────
# Where: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Where: Stripe Dashboard → Developers → Webhooks → your endpoint signing secret
STRIPE_WEBHOOK_SECRET=

# ─── PayPal (balance, Pay Later, cards) ────────────────────────────────────
# Where: https://developer.paypal.com/dashboard/applications
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# PAYPAL_ENV=live (default) or sandbox
PAYPAL_ENV=live
# Where: PayPal developer dashboard → Webhooks → Webhook ID
PAYPAL_WEBHOOK_ID=

# ─── Email (order receipts, download links, abandoned cart, newsletter) ────
# Where: https://resend.com/api-keys
RESEND_API_KEY=
# Sender identity, e.g. "Astralium <orders@yourdomain.com>"
EMAIL_FROM=Astralium Digitale Store <orders@example.com>

# ─── Admin (/[locale]/control-astralium) ───────────────────────────────────
# Choose a long random password yourself. If unset, admin login is disabled
# and the login page explains that it must be set.
ADMIN_PASSWORD=

# ─── Download link signing ─────────────────────────────────────────────────
# Any long random string (>= 32 chars). Used to HMAC-sign download tokens.
DOWNLOAD_SIGNING_SECRET=

# ─── Database (Phase 1 — orders, flags, file bindings, grants) ─────────────
# Optional: without it the store runs on the file catalog and admin file
# bindings persist to a local .data/ file instead. Set it to make feature
# flags, orders and product-file bindings durable.
# Where: your Postgres host — e.g. Neon (neon.tech → connection string),
# Supabase (Project → Settings → Database), Railway, or self-hosted.
DATABASE_URL=

# ─── Product file storage (Phase 1 — S3 / S3-compatible, private bucket) ───
# All four core keys are required together; the bucket must be PRIVATE
# (files are only ever served through short-lived presigned URLs).
# Where: AWS S3 console (bucket + IAM access key), Cloudflare R2 dashboard
# (R2 → Manage API tokens), Wasabi, or MinIO for local development.
S3_BUCKET=
# Where: the bucket's region (AWS console header / R2: use "auto").
S3_REGION=
# Where: the same console's access-key / API-token page.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Custom endpoint for S3-compatible providers; leave empty for AWS S3.
# Where: R2 → bucket details (https://<account>.r2.cloudflarestorage.com),
# MinIO (http://localhost:9000), Wasabi region endpoint.
S3_ENDPOINT=
# "1" for path-style addressing (required by MinIO, optional for R2);
# leave empty for AWS / virtual-host style.
S3_FORCE_PATH_STYLE=

# ─── Social delivery (Phase 2 — WhatsApp / Messenger / Instagram) ──────────
# Full step-by-step: docs/META_WHATSAPP_SETUP.md. Channels stay hidden until
# their feature flag is ON (admin → Feature flags) AND these keys are set.
# Messaging/money flags default OFF — the owner enables them deliberately.

# WhatsApp Business Cloud API — Where: Meta App → WhatsApp → API Setup
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# The store's WhatsApp number in international format — used for wa.me links.
WHATSAPP_BUSINESS_NUMBER=
# Webhook verify token — you invent this string and paste the same value in
# the Meta App → WhatsApp → Configuration → Webhook panel.
WHATSAPP_VERIFY_TOKEN=
# Approved template name (default astralium_delivery — see docs/whatsapp-template.md)
WHATSAPP_TEMPLATE_NAME=astralium_delivery

# Meta app (Messenger + Instagram + webhook signatures)
# Where: Meta App → Settings → Basic → App Secret
META_APP_SECRET=
# Webhook verify token for the shared /api/webhooks/meta endpoint (invented by you).
META_WEBHOOK_VERIFY_TOKEN=
# Facebook Page — Where: your Page → Settings → Page ID; token from Meta App → Messenger → Settings
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
# Instagram professional account — username (without @) + access token from
# Meta App → Instagram → API setup (account must be linked to the Page).
INSTAGRAM_USERNAME=
INSTAGRAM_ACCESS_TOKEN=

# PII encryption — encrypts stored phone numbers (AES-256-GCM, scrypt-derived).
# Any long random string (>= 16 chars). Without it, numbers are kept only as
# one-way hashes and proactive WhatsApp delivery falls back to email.
PII_ENCRYPTION_KEY=

# ─── Library & products (Phase 3) ──────────────────────────────────────────
# Maximum size (MB) for a free preview file served from storage; larger
# preview objects are refused by /api/preview. Default when unset: 25.
PREVIEW_MAX_MB=25
# Shared secret for the wishlist price-drop job: the scheduler must send
# it in the `x-cron-secret` header when POSTing /api/jobs/wishlist-alerts.
# Invent a long random string; without it the job endpoint refuses to run.
PRICE_ALERT_CRON_SECRET=

# ─── Commerce expansion (Phase 4) ──────────────────────────────────────────
# Shared secret for the Phase 4 cron jobs (scheduled gifts, pre-order
# releases, subscription dunning): the scheduler must send it in the
# `x-cron-secret` header when POSTing /api/jobs/gifts,
# /api/jobs/preorder-releases or /api/jobs/dunning. Invent a long random
# string. When unset, PRICE_ALERT_CRON_SECRET above is accepted as a
# fallback; with neither set, the job endpoints refuse to run.
CRON_SECRET=
# All other Phase 4 settings (flash-sale campaigns, PWYW floors/tiers,
# pre-order release dates, loyalty rates, referral commission %,
# subscription plans) are owner configuration stored in the database /
# admin panel — no env keys needed. Money features stay OFF until their
# feature flag is enabled in Admin → Feature flags.

# ─── Trust & content (Phase 5) ─────────────────────────────────────────────
# Maximum size (MB) for a bound PDF that the watermarking feature pulls
# through the app to stamp (buyer email + order id) at download time.
# Larger PDFs keep the presigned-redirect path. Default when unset: 50.
WATERMARK_MAX_MB=
# Everything else in Phase 5 is flag/config driven, no new keys:
#  - License keys, fraud threshold: Admin → License keys / Fraud shield.
#  - Blog posts, A/B experiments: Admin → Blog / A/B tests.
#  - Email automation jobs reuse CRON_SECRET above (POST
#    /api/jobs/email-automation) and stay OFF until enabled in
#    Admin → Feature flags. License verification is rate-limited per IP
#    in-process; no key needed.

# ─── AI support assistant (optional) ───────────────────────────────────────
# Where: https://platform.openai.com/api-keys — without it, the assistant
# answers from the local catalog/policy data only. Also used by the
# Phase 6 streaming assistant (flag: ai_support_v2) as its grounded
# context path; order lookups always run through the local tool layer.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ─── Platform (Phase 6) ────────────────────────────────────────────────────
# Owner alerts → Telegram (optional; the in-app inbox needs no keys).
# Where: create a bot with @BotFather for the token; the chat id comes
# from messaging the bot once and reading getUpdates. Empty = leg off.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Web Push (feature 28, flag: pwa_push). Generate a VAPID key pair with:
#   npx web-push generate-vapid-keys
# The public key is served to browsers; the private key never leaves the
# server. VAPID_SUBJECT is a mailto: or https: contact (defaults to
# NEXT_PUBLIC_SITE_URL when empty). Push subscription storage also
# requires PII_ENCRYPTION_KEY above.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Analytics salt (feature 27, optional): extra entropy for the
# daily-rotating visitor hash. When empty, DOWNLOAD_SIGNING_SECRET is
# reused; either way no raw IP is ever stored.
ANALYTICS_SALT=
# Everything else in Phase 6 is flag/config driven, no new keys:
#  - Owner digest email + owner WhatsApp number: Admin → Owner
#    notifications. The email digest job reuses CRON_SECRET (POST
#    /api/jobs/owner-digest); retention cleanup too (POST
#    /api/jobs/privacy-cleanup).
#  - Team accounts + TOTP secrets live in the database / .data store;
#    TOTP secrets are encrypted under a key derived from ADMIN_PASSWORD.

# ─── Runtime tuning, flag bootstrap & developer tooling ────────────────────
# Base backoff (ms) between delivery retries in the Phase-2 orchestrator
# (attempts double it each retry). Default when unset: 250. Rarely changed.
DELIVERY_RETRY_BACKOFF_MS=
# Feature-flag bootstrap override (src/lib/flags.ts): any flag in the
# registry can be forced at boot with FLAG_<KEY>=1 or =0, e.g.
# FLAG_DELIVERY_WHATSAPP=1 — consulted ONLY when the database has no row
# for that flag; the admin panel (database) stays the source of truth.
# (No value to set here — this note documents the pattern.)
# The two variables below serve the local verification scripts only; the
# store itself never reads them. Used by `npm run verify:phase1`
# (scripts/verify-phase1.mjs) against a throwaway local Postgres + server.
PHASE1_DATABASE_URL=
PHASE1_BASE_URL=
# Used by `npm run test:e2e` (scripts/e2e-smoke.mjs) only: port for the
# temporary production server it boots, and its startup timeout.
E2E_PORT=
E2E_TIMEOUT_MS=
# NODE_ENV and NEXT_RUNTIME are read by the code but are set automatically
# by Node/Next.js and the hosting platform — never set them yourself.
